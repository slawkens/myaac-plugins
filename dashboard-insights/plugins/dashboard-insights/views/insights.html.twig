<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div data-id="insights" class="sortable-handle col-sm-3 col-md-6 col-lg-12">
	<div class="card card-info card-outline">
		<div class="card-header">
			<div class="row">
				<div class="col">
					<h5 class="m-0">Insights</h5>
				</div>
				<div class="col">
					{{ include('_close_card_button.html.twig') }}
				</div>
			</div>
		</div>

		<div class="card-body p-3 row">
			<div class="col-md-6 col-sm-3">
				<label for="month">Month:</label>
				<select class="form-control" id="month" name="month">
					{% for id, name in months %}
						<option value="{{ id }}" {{ currentMonth == id ? 'selected="selected"' : '' }}>{{ name }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="col-md-6 col-sm-3">
				<label for="year">Year:</label>
				<select class="form-control" id="year" name="year">
					{% for year in range(firstYear, currentYear) %}
						<option value="{{ year }}" {{ currentYear == year ? 'selected' : '' }}>{{ year }}</option>
					{% endfor %}
				</select>
			</div>
		</div>

		<div id="insights-charts" class="card-body p-3 row">
			<div class="col-6 col-md-6">
				<div class="chart">
					<canvas id="lastLoginsChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
				</div>
			</div>
			<div class="col-6 col-md-6">
				<div class="chart">
					<canvas id="lastCreatedChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
				</div>
			</div>
		</div>
	</div>
</div>
<script>
	function updateCharts()
	{
		$.ajax({
			type: "POST",
			dataType: "json",
			url: "/ajax/insights",
			data: { year: $('#year').val(), month: $('#month').val() },
			success: function(data) {
				let accountsLabels = [];
				let playersLabels = [];

				let accountsData = [];
				let playersData = [];

				data.lastCreatedAccounts.forEach(account => accountsLabels.push(account.date));
				data.lastLoginPlayers.forEach(player => playersLabels.push(player.date));

				data.lastCreatedAccounts.forEach(account => accountsData.push(account.how_much));
				data.lastLoginPlayers.forEach(player => playersData.push(player.how_much));

				var newDataset = {
					label: "Logged players",
					backgroundColor: ["#3e95cd"],
					data: playersData,
				}

				chartLastLogins.data.labels = [];
				chartLastLogins.data.labels.push(...playersLabels);
				chartLastLogins.data.datasets = [];
				chartLastLogins.data.datasets.push(newDataset);
				chartLastLogins.update();

				var newDataset = {
					label: "Accounts created",
					backgroundColor: ["#3cba9f"],
					data: accountsData,
				}

				chartAccountsCreated.data.labels = [];
				chartAccountsCreated.data.labels.push(...accountsLabels);
				chartAccountsCreated.data.datasets = [];
				chartAccountsCreated.data.datasets.push(newDataset);
				chartAccountsCreated.update();
			},
			error: function (xhr, ajaxOptions, thrownError){
				console.log(thrownError);
			}
		});
	}

	$(function ()
	{
		updateCharts();

		$('#year').on('change', function() {
			updateCharts();
		});

		$('#month').on('change', function() {
			updateCharts();
		});
	});

	const configLastLogins = {
		type: 'bar',
	}
	const chartLastLogins = new Chart(document.getElementById('lastLoginsChart'), configLastLogins);

	const configAccountsCreated = {
		type: 'bar',
	}
	const chartAccountsCreated = new Chart(document.getElementById('lastCreatedChart'), configAccountsCreated);
</script>
