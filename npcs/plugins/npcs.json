{
	"name": "NPCs",
	"description": "Loads NPCs (XML & Lua), to block creating characters with NPC names.",
	"version": "1.0",
	"type": "page",
	"license": "GPLv3",
	"author": "slawkens",
	"contact": "slawkens@gmail.com",
	"require": {
		"myaac": "3.0-dev",
		"php": "8.1"
	},
	"hooks": [
		{
			"type": "HOOK_FILTER_VALIDATE_CHARACTER_NEW_NAME",
			"file": "plugins/npcs/hooks/validate-character-name.php"
		},
		{
			"type": "HOOK_FILTER_ADMIN_DASHBOARD_STATISTICS",
			"file": "plugins/npcs/hooks/admin-dashboard-statistics.php"
		},
		{
			"type": "HOOK_ADMIN_SERVER_DATA_RELOAD",
			"file": "plugins/npcs/hooks/admin-server-data-reload.php"
		}
	],
	"uninstall": [
		"plugins/npcs.json",
		"plugins/npcs"
	]
}
